{
  "name": "@bello/api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "bootstrap:admin": "node dist/bootstrap/bootstrap-cli.main.js",
    "prisma:generate": "prisma generate",
    "lint": "oxlint --type-aware src/ test/",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.{ts,json}\"",
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts --exclude test/prisma-transaction.e2e-spec.ts --exclude test/f1-a-1-postgresql.e2e-spec.ts --exclude test/f1-a-2-bootstrap-provider.e2e-spec.ts --exclude test/f1-a-2-bootstrap-cli.e2e-spec.ts --exclude test/f1-b-2-1-auth-session.e2e-spec.ts --exclude test/f1-b-2-3-session-persistence.e2e-spec.ts --exclude test/f1-b-3-3-2-failed-login.e2e-spec.ts --exclude test/f1-b-3-3-3-authentication.e2e-spec.ts --exclude test/f1-b-4-5-1-password-recovery-foundation.e2e-spec.ts",
    "test:prisma": "vitest run --config ./vitest.config.e2e.ts test/prisma.e2e-spec.ts",
    "test:transaction": "vitest run --config ./vitest.config.e2e.ts test/prisma-transaction.e2e-spec.ts",
    "test:f1a1": "vitest run --config ./vitest.config.e2e.ts test/f1-a-1-postgresql.e2e-spec.ts",
    "test:f1a2:provider": "vitest run --config ./vitest.config.e2e.ts test/f1-a-2-bootstrap-provider.e2e-spec.ts",
    "test:f1a2:cli": "nest build && vitest run --config ./vitest.config.e2e.ts test/f1-a-2-bootstrap-cli.e2e-spec.ts",
    "test:f1b:sessions": "vitest run --config ./vitest.config.e2e.ts test/f1-b-2-1-auth-session.e2e-spec.ts",
    "test:f1b:persistence": "vitest run --config ./vitest.config.e2e.ts test/f1-b-2-3-session-persistence.e2e-spec.ts",
    "test:f1b:failed-login": "vitest run --config ./vitest.config.e2e.ts test/f1-b-3-3-2-failed-login.e2e-spec.ts",
    "test:f1b:authentication": "vitest run --config ./vitest.config.e2e.ts test/f1-b-3-3-3-authentication.e2e-spec.ts",
    "test:f1b:password-recovery-foundation": "vitest run --config ./vitest.config.e2e.ts test/f1-b-4-5-1-password-recovery-foundation.e2e-spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.44.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.4",
    "@nestjs/testing": "12.3.2",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.12",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "source-map-support": "0.5.21",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
