generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                      String                    @id @db.Uuid
  firstName               String                    @map("first_name") @db.VarChar(100)
  lastName                String                    @map("last_name") @db.VarChar(100)
  email                   String                    @db.VarChar(254)
  emailKey                String                    @unique(map: "account_email_key_key") @map("email_key") @db.VarChar(254)
  emailVerifiedAt         DateTime?                 @map("email_verified_at") @db.Timestamptz(6)
  status                  String                    @db.VarChar(20)
  createdAt               DateTime                  @map("created_at") @db.Timestamptz(6)
  deactivatedAt           DateTime?                 @map("deactivated_at") @db.Timestamptz(6)
  credential              PasswordCredential?
  authSessions            AuthSession[]
  recoveryRequests        PasswordRecoveryRequest[]
  passwordResetTokens     PasswordResetToken[]
  passwordResetOperations PasswordResetOperation[]
  globalRoles             GlobalRoleAssignment[]
  bootstrapStates         BootstrapState[]
  auditEvents             AuditEvent[]
  workspaceMemberships    WorkspaceMembership[]
  comments                CardComment[] @relation("CommentAuthor")
  removedComments         CardComment[] @relation("CommentRemover")
  completedCards          BoardCard[]
  accessNoticesReceived   AccessNotification[]      @relation("AccessNoticeRecipient")
  accessNoticesIssued     AccessNotification[]      @relation("AccessNoticeActor")

  @@map("account")
}

model AuthSession {
  id                 String    @id @db.Uuid
  accountId          String    @map("account_id") @db.Uuid
  tokenHash          Bytes     @unique(map: "auth_session_token_hash_key") @map("token_hash") @db.ByteA
  createdAt          DateTime  @map("created_at") @db.Timestamptz(6)
  lastActivityAt     DateTime  @map("last_activity_at") @db.Timestamptz(6)
  absoluteExpiresAt  DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  createdOperationId String    @unique(map: "auth_session_created_operation_id_key") @map("created_operation_id") @db.Uuid
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(6)
  revocationReason   String?   @map("revocation_reason") @db.VarChar(40)
  revokedOperationId String?   @map("revoked_operation_id") @db.Uuid
  account            Account   @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([revokedOperationId], map: "auth_session_revoked_operation_id_idx")
  @@map("auth_session")
}

model PasswordCredential {
  accountId          String   @id @map("account_id") @db.Uuid
  passwordHash       String   @map("password_hash") @db.Text
  changedAt          DateTime @map("changed_at") @db.Timestamptz(6)
  changedOperationId String   @unique(map: "password_credential_changed_operation_id_key") @map("changed_operation_id") @db.Uuid
  account            Account  @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("password_credential")
}

model PasswordRecoveryRequest {
  recoveryRequestId    String                            @id @map("recovery_request_id") @db.Uuid
  accountId            String?                           @map("account_id") @db.Uuid
  state                String                            @db.VarChar(20)
  receivedAt           DateTime                          @map("received_at") @db.Timestamptz(6)
  updatedAt            DateTime                          @map("updated_at") @db.Timestamptz(6)
  terminalAt           DateTime?                         @map("terminal_at") @db.Timestamptz(6)
  currentAttemptNumber Int                               @map("current_attempt_number") @db.SmallInt
  cancelledOperationId String?                           @map("cancelled_operation_id") @db.Uuid
  account              Account?                          @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  deliveryAttempts     PasswordRecoveryDeliveryAttempt[]

  @@index([accountId, receivedAt(sort: Desc), recoveryRequestId], map: "password_recovery_request_account_received_idx")
  @@index([state, updatedAt, recoveryRequestId], map: "password_recovery_request_state_updated_idx")
  @@index([cancelledOperationId], map: "password_recovery_request_cancelled_operation_idx")
  @@map("password_recovery_request")
}

model PasswordRecoveryDeliveryAttempt {
  deliveryAttemptId    String                  @id @map("delivery_attempt_id") @db.Uuid
  recoveryRequestId    String                  @map("recovery_request_id") @db.Uuid
  attemptNumber        Int                     @map("attempt_number") @db.SmallInt
  state                String                  @db.VarChar(20)
  scheduledAt          DateTime                @map("scheduled_at") @db.Timestamptz(6)
  leaseId              String?                 @map("lease_id") @db.Uuid
  leaseExpiresAt       DateTime?               @map("lease_expires_at") @db.Timestamptz(6)
  sendingConfirmedAt   DateTime?               @map("sending_confirmed_at") @db.Timestamptz(6)
  acceptedAt           DateTime?               @map("accepted_at") @db.Timestamptz(6)
  terminalAt           DateTime?               @map("terminal_at") @db.Timestamptz(6)
  failureClass         String?                 @map("failure_class") @db.VarChar(30)
  cancelledOperationId String?                 @map("cancelled_operation_id") @db.Uuid
  recoveryRequest      PasswordRecoveryRequest @relation(fields: [recoveryRequestId], references: [recoveryRequestId], onDelete: Restrict, onUpdate: Restrict)
  resetToken           PasswordResetToken?

  @@unique([recoveryRequestId, attemptNumber], map: "password_recovery_delivery_attempt_request_number_key")
  @@index([state, scheduledAt, deliveryAttemptId], map: "password_recovery_delivery_attempt_state_schedule_idx")
  @@index([cancelledOperationId], map: "password_recovery_delivery_attempt_cancelled_operation_idx")
  @@map("password_recovery_delivery_attempt")
}

model PasswordResetToken {
  passwordResetTokenId   String                          @id @map("password_reset_token_id") @db.Uuid
  deliveryAttemptId      String                          @unique(map: "password_reset_token_delivery_attempt_id_key") @map("delivery_attempt_id") @db.Uuid
  accountId              String                          @map("account_id") @db.Uuid
  tokenHash              Bytes                           @unique(map: "password_reset_token_hash_key") @map("token_hash") @db.ByteA
  createdAt              DateTime                        @map("created_at") @db.Timestamptz(6)
  expiresAt              DateTime                        @map("expires_at") @db.Timestamptz(6)
  consumedAt             DateTime?                       @map("consumed_at") @db.Timestamptz(6)
  consumedOperationId    String?                         @unique(map: "password_reset_token_consumed_operation_id_key") @map("consumed_operation_id") @db.Uuid
  invalidatedAt          DateTime?                       @map("invalidated_at") @db.Timestamptz(6)
  invalidatedOperationId String?                         @map("invalidated_operation_id") @db.Uuid
  deliveryAttempt        PasswordRecoveryDeliveryAttempt @relation(fields: [deliveryAttemptId], references: [deliveryAttemptId], onDelete: Restrict, onUpdate: Restrict)
  account                Account                         @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resetOperations        PasswordResetOperation[]

  @@index([invalidatedOperationId], map: "password_reset_token_invalidated_operation_idx")
  @@map("password_reset_token")
}

model PasswordResetOperation {
  resetOperationId           String             @id @map("reset_operation_id") @db.Uuid
  accountId                  String             @map("account_id") @db.Uuid
  passwordResetTokenId       String             @map("password_reset_token_id") @db.Uuid
  expectedChangedOperationId String             @map("expected_changed_operation_id") @db.Uuid
  state                      String             @db.VarChar(20)
  startedAt                  DateTime           @map("started_at") @db.Timestamptz(6)
  updatedAt                  DateTime           @map("updated_at") @db.Timestamptz(6)
  terminalAt                 DateTime?          @map("terminal_at") @db.Timestamptz(6)
  account                    Account            @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  passwordResetToken         PasswordResetToken @relation(fields: [passwordResetTokenId], references: [passwordResetTokenId], onDelete: Restrict, onUpdate: Restrict)

  @@index([state, updatedAt, resetOperationId], map: "password_reset_operation_state_updated_idx")
  @@index([accountId], map: "password_reset_operation_account_id_idx")
  @@index([passwordResetTokenId], map: "password_reset_operation_token_id_idx")
  @@map("password_reset_operation")
}

model GlobalRoleAssignment {
  accountId String   @map("account_id") @db.Uuid
  role      String   @db.VarChar(30)
  grantedAt DateTime @map("granted_at") @db.Timestamptz(6)
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([accountId, role], map: "global_role_assignment_pkey")
  @@map("global_role_assignment")
}

model BootstrapState {
  singletonId      Int       @id @map("singleton_id") @db.SmallInt
  status           String    @db.VarChar(20)
  initialAccountId String?   @map("initial_account_id") @db.Uuid
  operationId      String?   @unique(map: "bootstrap_state_operation_id_key") @map("operation_id") @db.Uuid
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(6)
  initialAccount   Account?  @relation(fields: [initialAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("bootstrap_state")
}

model AuditEvent {
  id             String   @id @db.Uuid
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(6)
  actorAccountId String?  @map("actor_account_id") @db.Uuid
  origin         String   @db.VarChar(40)
  scope          String   @db.VarChar(40)
  operation      String   @db.VarChar(60)
  result         String   @db.VarChar(30)
  entityType     String   @map("entity_type") @db.VarChar(40)
  entityId       String?  @map("entity_id") @db.Uuid
  beforeData     Json?    @map("before_data") @db.JsonB
  afterData      Json?    @map("after_data") @db.JsonB
  context        Json?    @db.JsonB
  correlationId  String   @map("correlation_id") @db.Uuid
  operationId    String   @map("operation_id") @db.Uuid
  sequence       Int
  actorAccount   Account? @relation(fields: [actorAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([operationId, sequence], map: "audit_event_operation_id_sequence_key")
  @@index([occurredAt(sort: Desc), id(sort: Desc)], map: "audit_event_occurred_at_id_idx")
  @@map("audit_event")
}

model Workspace {
  id            String                @id @db.Uuid
  name          String                @db.VarChar(100)
  description   String?               @db.VarChar(2000)
  timeZone      String                @map("time_zone") @db.VarChar(100)
  members       WorkspaceMembership[]
  boards        Board[]
  accessNotices AccessNotification[]

  labels WorkspaceLabel[]

  @@map("workspace")
}

model WorkspaceMembership {
  workspaceId String            @map("workspace_id") @db.Uuid
  accountId   String            @map("account_id") @db.Uuid
  role        String            @db.VarChar(20)
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  account     Account           @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  boards      BoardMembership[]

  @@id([workspaceId, accountId])
  @@index([accountId, workspaceId])
  @@map("workspace_membership")
}

model Board {
  id            String               @id @db.Uuid
  workspaceId   String               @map("workspace_id") @db.Uuid
  name          String               @db.VarChar(100)
  description   String               @db.VarChar(2000)
  visibility    String               @default("PRIVATE") @db.VarChar(20)
  orderRevision Int @default(0) @map("order_revision")
  syncRevision Int @default(0) @map("sync_revision")
  archived      Boolean              @default(false)
  workspace     Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  members       BoardMembership[]
  feed          BoardFeedEvent[]
  lists         BoardList[]
  accessNotices AccessNotification[]

  @@unique([workspaceId, id])
  @@map("board")
}

model BoardMembership {
  workspaceId     String              @map("workspace_id") @db.Uuid
  boardId         String              @map("board_id") @db.Uuid
  accountId       String              @map("account_id") @db.Uuid
  role            String              @db.VarChar(20)
  board           Board               @relation(fields: [workspaceId, boardId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  workspaceMember WorkspaceMembership @relation(fields: [workspaceId, accountId], references: [workspaceId, accountId], onDelete: Restrict, onUpdate: Restrict)

  assignments CardAssignment[]

  @@id([workspaceId, boardId, accountId])
  @@index([workspaceId, accountId])
  @@map("board_membership")
}

model BoardFeedEvent {
  id         String   @id @db.Uuid
  boardId    String   @map("board_id") @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  subjectAccountId String? @map("subject_account_id") @db.Uuid
  labelId String? @map("label_id") @db.Uuid
  commentId String? @map("comment_id") @db.Uuid
  requestHash String? @map("request_hash") @db.Char(64)
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  operation  String   @db.VarChar(60)
  listId     String?  @map("list_id") @db.Uuid
  cardId     String?  @map("card_id") @db.Uuid
  board      Board    @relation(fields: [boardId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([boardId, occurredAt, id])
  @@map("board_feed_event")
}

model AccessNotification {
  id          String                      @id @db.Uuid
  recipientId String                      @map("recipient_id") @db.Uuid
  actorId     String                      @map("actor_id") @db.Uuid
  workspaceId String                      @map("workspace_id") @db.Uuid
  boardId     String?                     @map("board_id") @db.Uuid
  grantedRole String                      @map("granted_role") @db.VarChar(20)
  createdAt   DateTime                    @map("created_at") @db.Timestamptz(6)
  recipient   Account                     @relation("AccessNoticeRecipient", fields: [recipientId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor       Account                     @relation("AccessNoticeActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  workspace   Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  board       Board?                      @relation(fields: [workspaceId, boardId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  delivery    AccessNotificationDelivery?

  @@index([recipientId, createdAt, id])
  @@map("access_notification")
}

model AccessNotificationDelivery {
  notificationId String             @id @map("notification_id") @db.Uuid
  state          String             @default("PENDING") @db.VarChar(20)
  attemptCount   Int                @default(0) @map("attempt_count")
  updatedAt      DateTime           @map("updated_at") @db.Timestamptz(6)
  notification   AccessNotification @relation(fields: [notificationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([state, updatedAt, notificationId])
  @@map("access_notification_delivery")
}

model BoardList {
  id           String      @id @db.Uuid
  boardId      String      @map("board_id") @db.Uuid
  name         String      @db.VarChar(100)
  creationHash String      @map("creation_hash") @db.Char(64)
  archived     Boolean     @default(false)
  position BigInt
  positionRevision Int @default(0) @map("position_revision")
  cardOrderRevision Int @default(0) @map("card_order_revision")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  board        Board       @relation(fields: [boardId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cards        BoardCard[]

  @@index([boardId, createdAt, id])
  @@unique([boardId, position])
  @@map("board_list")
}

model BoardCard {
  id           String    @id @db.Uuid
  listId       String    @map("list_id") @db.Uuid
  title        String    @db.VarChar(200)
  description  String?   @db.VarChar(20000)
  creationHash String    @map("creation_hash") @db.Char(64)
  startDate DateTime? @map("start_date") @db.Date
  dueDate DateTime? @map("due_date") @db.Date
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  completedById String? @map("completed_by_id") @db.Uuid
  completedBy Account? @relation(fields: [completedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  archived     Boolean   @default(false)
  position BigInt
  positionRevision Int @default(0) @map("position_revision")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  list         BoardList @relation(fields: [listId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  assignments CardAssignment[]

  labels CardLabel[]

  comments CardComment[]

  @@index([listId, createdAt, id])
  @@unique([listId, position])
  @@map("board_card")
}

model CardAssignment {
  id          String @id @db.Uuid
  cardId      String @map("card_id") @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  boardId     String @map("board_id") @db.Uuid
  accountId   String @map("account_id") @db.Uuid
  card        BoardCard @relation(fields: [cardId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  member      BoardMembership @relation(fields: [workspaceId, boardId, accountId], references: [workspaceId, boardId, accountId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([cardId, accountId])
  @@index([workspaceId, boardId, accountId])
  @@map("card_assignment")
}

model WorkspaceLabel {
  id          String @id @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  name        String @db.VarChar(50)
  color       String? @db.VarChar(7)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cards       CardLabel[]

  @@unique([workspaceId, id])
  @@map("workspace_label")
}

model CardLabel {
  cardId      String @map("card_id") @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  labelId     String @map("label_id") @db.Uuid
  card        BoardCard @relation(fields: [cardId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  label       WorkspaceLabel @relation(fields: [workspaceId, labelId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([cardId, labelId])
  @@index([workspaceId, labelId])
  @@map("card_label")
}

model CardComment {
  id          String @id @db.Uuid
  cardId      String @map("card_id") @db.Uuid
  authorId    String @map("author_id") @db.Uuid
  content     String? @db.VarChar(10000)
  createdAt   DateTime @map("created_at") @db.Timestamptz(6)
  editedAt    DateTime? @map("edited_at") @db.Timestamptz(6)
  removedAt   DateTime? @map("removed_at") @db.Timestamptz(6)
  removedById String? @map("removed_by_id") @db.Uuid
  card        BoardCard @relation(fields: [cardId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  author      Account @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  removedBy   Account? @relation("CommentRemover", fields: [removedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([cardId, createdAt, id])
  @@map("card_comment")
}
